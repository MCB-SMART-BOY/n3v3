-- Flake definition for system-config example
-- 系统配置示例的 Flake 定义
flake = { description = "Example system configuration for n3v3", inputs = { nevepkgs = { url = "github:neve-lang/nevepkgs" } }, outputs = |inputs| ({
  system = { hostname = "n3v3-server", timezone = "Asia/Shanghai", locale = "en_US.UTF-8", packages = [inputs.nevepkgs.git, inputs.nevepkgs.curl, inputs.nevepkgs.n3v3], services = {
    sshd = { enable = true },
    nginx = { enable = true }
  }, users = { admin = { isAdmin = true, home = "/home/admin", shell = "/bin/bash" } }, firewall = {
    enable = true,
    allowedTCPPorts = [22, 80, 443]
  } },
  checks = { minimal = fn() {
    true
  } }
}) }
