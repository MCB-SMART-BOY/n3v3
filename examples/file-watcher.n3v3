#!/usr/bin/env n3v3
-- One-shot file scan: reports the current file count
-- 单次文件扫描：报告当前文件数量
use std.io = io

dir = match io.args() {
  (args, _) -> match args {
    [d, ..] -> d,
    [] -> ".",
  },
}

io.println("Scanning " + dir + "...");

-- Scan once and report file count; this example does not watch continuously.
-- Note: io.glob returns a List of Path values in the current directory
files = io.glob(dir + "/*")

count = len(files)

io.println("[" + toString(count) + "] files at now");

0
