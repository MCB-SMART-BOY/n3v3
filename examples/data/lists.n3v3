use std.list = list

empty = []

numbers = [1, 2, 3, 4, 5]

names = ["alice", "bob", "charlie"]

sum = |xs| {
  match xs {
    [] -> 0,
    [x, ..rest] -> x + sum(rest),
  }
}

println(sum([1, 2, 3, 4, 5]));

double = |x| {
  x * 2
}

doubled = list.map(double, [1, 2, 3])

println(doubled);

isEven = |x| {
  x % 2 == 0
}

evens = list.filter(isEven, [1, 2, 3, 4, 5, 6])

println(evens);

println(list.len([1, 2, 3]));

first = |xs| {
  match xs {
    [] -> "empty",
    [x, ..] -> toString(x),
  }
}

println(first([10, 20, 30]))
