classify = |n| {
  match n {
    0 -> "zero",
    1 -> "one",
    _ -> "many",
  }
}

println(classify(0));

println(classify(1));

println(classify(42));

describe = |b| {
  match b {
    true -> "yes",
    false -> "no",
  }
}

println(describe(1 == 1));

println(describe(1 == 2));

result = match 15 {
  0 -> "nothing",
  n -> "got " + toString(n),
}

println(result);

score = |grade| {
  match grade {
    "A" -> 4,
    "B" -> 3,
    "C" -> 2,
    _ -> 0,
  }
}

println(score("A"))
