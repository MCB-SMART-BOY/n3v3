#!/usr/bin/env n3v3 run
use std.io = io

main() = {
  let (args, _) = io.args();
  let name = match args {
    [n, ..] -> n,
    [] -> "World",
  };
  io.println("Hello, " ++ name ++ "!");
  let files = io.glob("*.n3v3");
  let count = len(files);
  io.println("Found " ++ toString(count) ++ " .n3v3 files");
  0
}
