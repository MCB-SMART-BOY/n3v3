type Result = | Ok(Int) | Err(String);

safe_div(a: Int, b: Int) -> Result = {
  if b == 0 -> Err("division by zero") else Ok(a / b)
}

divide_or_zero(a: Int, b: Int) -> Int = match safe_div(a, b) {
  Ok(v) -> v,
  Err(_) -> 0,
}

ok = safe_div(10, 2)

err = safe_div(10, 0)

def = divide_or_zero(10, 0)
