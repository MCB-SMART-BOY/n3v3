type UserId = Int;

type Point = {
  x: Float,
  y: Float,
};

type Color = | Red | Green | Blue | RGB(Int, Int, Int);

add(x: Int, y: Int) -> Int = x + y

double(x: _) = x * 2

greet(name: String) -> String = {
  let greeting = `Hello, {name}!`;
  greeting
}

multiply = |x, y| x * y

answer = 42

pi: Float = 3.14159

message = "n3v3 is fun!"

flag = true

unit = ()

name = "World"

welcome = `Hi {name}, the answer is {add(40, 2)}`

status = if answer > 0 -> "positive" else "non-positive"

piped = 10 |> double |> double

numbers = [1, 2, 3, 4, 5]

empty_list: List<Int> = []

combined = [1, 2] ++ [3, 4]

evens = [x | x <- numbers, x % 2 == 0]

doubled = [x * 2 | x <- numbers]

