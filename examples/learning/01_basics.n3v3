origin = { x = 0, y = 0 }

x_val = 5

y_val = 7

quick = { x = x_val, y = y_val }

moved = point & { x = 15 }

point_x = point.x

result = { answer = answer, doubled = doubled, evens = evens, point = moved, piped = piped }
