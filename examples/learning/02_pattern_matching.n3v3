describe(x: Int) -> String = match x {
  0 -> "zero",
  1 -> "one",
  _ -> "other",
}

is_special(x: Int) -> Bool = match x {
  0 | 1 | 2 -> true,
  _ -> false,
}

type Color = | Red | Green | Blue;

color_name(c: Color) -> String = match c {
  Red -> "red",
  Green -> "green",
  Blue -> "blue",
}

type Option = | Some(Int) | None;

unwrap_or(opt: Option, default: Int) -> Int = match opt {
  Some(v) -> v,
  None -> default,
}

list_sum(xs: List<Int>) -> Int = match xs {
  [] -> 0,
  [h, ..t] -> h + list_sum(t),
}

r1 = describe(0)

r2 = color_name(Red())

r3 = list_sum([1, 2, 3])
