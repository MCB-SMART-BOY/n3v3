#!/usr/bin/env n3v3
-- Test discovery demo: lists .n3v3 test files without executing them
-- 测试发现演示：列出 .n3v3 测试文件，但不执行测试
use std.io = io

use std.string = str

dir = match io.args() {
  (args, _) -> match args {
    [d, ..] -> d,
    [] -> "tests",
  },
}

files = io.glob(str.concat(dir, "/*.n3v3"))

io.println(str.concat("Test files in ", dir, ":"));

_ = io.streamForEach(io.streamList(files), |f| {
  io.println(str.concat("  ", f));
  ()
})

io.println(str.concat("\nFound ", toString(len(files)), " test file(s)"));

0
